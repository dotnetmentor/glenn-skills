# AI voiceover provider keys (optional — without any key the engine uses offline espeak).
# Provide ONE of these via your environment, or drop the raw key into a gitignored
# file next to the engine / in your VIDEO_DIR (.elevenlabs-key or .gemini-key).

# ElevenLabs (recommended; eleven_multilingual_v2). Needs a PAID plan from cloud IPs.
ELEVENLABS_API_KEY=

# Google Gemini TTS (alternative).
GEMINI_API_KEY=

# Optional overrides:
# TTS_PROVIDER=elevenlabs        # elevenlabs | gemini | espeak
# VOICES=Daniel                  # ElevenLabs name (Sarah/Charlotte/Alice/George/Daniel) or a voice_id
# ELEVEN_VOICE_ID=               # raw voice_id to override the name map
